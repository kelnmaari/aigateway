[aigateway]
name=AIGateway RPM Repository
baseurl=https://gitlab.alexue4.dev/api/v4/projects/${PROJECT_ID}/packages/rpm
enabled=1
gpgcheck=0
repo_gpgcheck=0
sslverify=1

# For private projects, replace baseurl with:
# baseurl=https://TOKEN_NAME:TOKEN_VALUE@gitlab.alexue4.dev/api/v4/projects/PROJECT_ID/packages/rpm
#
# Create a Deploy Token in GitLab:
# Settings -> Repository -> Deploy Tokens
# Grant: read_package_registry

