[Unit]
Description=AIGateway Server
Documentation=https://github.com/kelnmaari/ollama-openai-proxy
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/aigateway
ExecStart=/opt/aigateway/bin/aigateway-linux-amd64 -config /opt/aigateway/configs/dev.yaml

# Environment
Environment="GIN_MODE=release"

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=1800s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity

# Security hardening (optional, comment if causes issues)
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/opt/aigateway/data

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aigateway

[Install]
WantedBy=multi-user.target
