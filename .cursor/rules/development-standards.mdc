### Error Handling Standards
```go
// Use wrapped errors with context
func (s *Server) processRequest(ctx context.Context, req Request) error {
    if err := s.validateRequest(req); err != nil {
        return fmt.Errorf("request validation failed: %w", err)
    }
    
    if err := s.routeToProvider(ctx, req); err != nil {
        return fmt.Errorf("failed to route request to provider: %w", err)
    }
    
    return nil
}

// Custom error types for specific domains
type ValidationError struct {
    Field   string
    Message string
    Value   interface{}
}

func (e ValidationError) Error() string {
    return fmt.Sprintf("validation error for field '%s': %s (value: %v)", 
        e.Field, e.Message, e.Value)
}

// Check if error is of specific type
func IsValidationError(err error) bool {
    var validationErr ValidationError
    return errors.As(err, &validationErr)
}
```

### Logging Standards
```go
// Use structured logging with consistent fields
func (l *Logger) LogRequest(ctx context.Context, method, path string, duration time.Duration) {
    l.WithFields(logrus.Fields{
        "method":     method,
        "path":       path,
        "duration":   duration,
        "request_id": getRequestID(ctx),
        "user_id":    getUserID(ctx),
    }).Info("request processed")
}

// Never log sensitive data
func (l *Logger) LogAPIKeyCreated(keyID string) {
    l.WithFields(logrus.Fields{
        "event":  "api_key_created",
        "key_id": keyID,
        // NEVER log the actual key
    }).Info("API key created")
}
```

