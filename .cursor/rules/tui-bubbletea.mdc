# Bubbletea TUI Development Patterns

## 🎨 TUI Architecture (Bubbletea + Lipgloss + Bubbles)

### Core TUI Pattern
```go
import (
    tea "github.com/charmbracelet/bubbletea"
    "github.com/charmbracelet/lipgloss"
    "github.com/charmbracelet/bubbles/table"
    "github.com/charmbracelet/bubbles/textinput"
    "github.com/charmbracelet/bubbles/viewport"
)

type Model struct {
    currentView string
    width       int
    height      int
    
    // Component models
    table      table.Model
    textInput  textinput.Model
    viewport   viewport.Model
    
    // Application state
    apiKeys    []APIKey
    metrics    Metrics
    logs       []LogEntry
}
```

### Message-Driven Updates
```go
type (
    // Custom messages for TUI communication
    metricsUpdateMsg struct{ metrics Metrics }
    apiKeyCreatedMsg struct{ key APIKey }
    logEntryMsg      struct{ entry LogEntry }
    errorMsg         struct{ error error }
)

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
    switch msg := msg.(type) {
    case tea.WindowSizeMsg:
        m.width = msg.Width
        m.height = msg.Height
        return m, nil
        
    case tea.KeyMsg:
        return m.handleKeyPress(msg)
        
    case metricsUpdateMsg:
        m.metrics = msg.metrics
        return m, m.fetchNextMetrics() // Continue polling
        
    case apiKeyCreatedMsg:
        m.apiKeys = append(m.apiKeys, msg.key)
        return m, showSuccessMsg("API Key created")
    }
    
    return m, nil
}
```

### Styled Components with Lipgloss
```go
var (
    // Color palette
    primaryColor   = lipgloss.Color("#7D56F4")
    successColor   = lipgloss.Color("#04B575")
    errorColor     = lipgloss.Color("#FF6B6B")
    warningColor   = lipgloss.Color("#FF8C42")
    textColor      = lipgloss.Color("#FAFAFA")
    dimTextColor   = lipgloss.Color("#666")
    
    // Common styles
    titleStyle = lipgloss.NewStyle().
        Background(primaryColor).
        Foreground(textColor).
        Padding(0, 1).
        Bold(true)
        
    successStyle = lipgloss.NewStyle().
        Foreground(successColor).
        Bold(true)
        
    errorStyle = lipgloss.NewStyle().
        Foreground(errorColor).
        Bold(true)
        
    borderStyle = lipgloss.NewStyle().
        Border(lipgloss.RoundedBorder()).
        BorderForeground(primaryColor).
        Padding(1, 2)
        
    // Layout styles
    columnStyle = lipgloss.NewStyle().
        Width(30).
        Padding(0, 1)
)
```

### Screen Views Implementation
```go
// Dashboard View
func (m Model) renderDashboard() string {
    // Server status section
    serverStatus := m.renderServerStatus()
    
    // Metrics section  
    metricsView := m.renderMetrics()
    
    // Recent activity
    activityView := m.renderRecentActivity()
    
    // Layout using lipgloss
    return lipgloss.JoinVertical(
        lipgloss.Left,
        titleStyle.Render("🦙 Dashboard"),
        "",
        lipgloss.JoinHorizontal(
            lipgloss.Top,
            columnStyle.Render(serverStatus),
            columnStyle.Render(metricsView),
            columnStyle.Render(activityView),
        ),
    )
}

// Request Monitor View  
func (m Model) renderRequestMonitor() string {
    if len(m.requests) == 0 {
        return borderStyle.Render("No active requests")
    }
    
    // Create table for requests
    rows := make([]table.Row, len(m.requests))
    for i, req := range m.requests {
        rows[i] = table.Row{
            req.Timestamp.Format("15:04:05"),
            req.Method,
            req.Endpoint,
            req.Status,
            req.Duration.String(),
        }
    }
    
    m.table.SetRows(rows)
    return borderStyle.Render(m.table.View())
}
```

### Real-time Data Updates
```go
// Command for fetching metrics periodically
func fetchMetricsCmd() tea.Cmd {
    return tea.Tick(time.Second, func(t time.Time) tea.Msg {
        // Fetch metrics from server
        metrics, err := fetchCurrentMetrics()
        if err != nil {
            return errorMsg{err}
        }
        return metricsUpdateMsg{metrics}
    })
}

// Command for fetching logs
func fetchLogsCmd() tea.Cmd {
    return func() tea.Msg {
        logs, err := fetchRecentLogs()
        if err != nil {
            return errorMsg{err}
        }
        return logsUpdateMsg{logs}
    }
}
```

### Navigation System
```go
const (
    dashboardView   = "dashboard"
    requestsView    = "requests" 
    modelsView      = "models"
    apiKeysView     = "apikeys"
    configView      = "config"
    logsView        = "logs"
)

func (m Model) handleKeyPress(msg tea.KeyMsg) (tea.Model, tea.Cmd) {
    switch msg.String() {
    case "ctrl+c", "q":
        return m, tea.Quit
        
    // Navigation
    case "1":
        m.currentView = dashboardView
    case "2": 
        m.currentView = requestsView
    case "3":
        m.currentView = modelsView
    case "4":
        m.currentView = apiKeysView
    case "5":
        m.currentView = configView
    case "6":
        m.currentView = logsView
        
    // Refresh current view
    case "r":
        return m, m.refreshCurrentView()
    }
    
    return m, nil
}
```

### Interactive Components
```go
// API Key creation form
func (m Model) renderAPIKeyForm() string {
    if !m.showingForm {
        return helpStyle.Render("Press 'n' to create new API key")
    }
    
    form := lipgloss.JoinVertical(
        lipgloss.Left,
        titleStyle.Render("Create New API Key"),
        "",
        "Name: " + m.keyNameInput.View(),
        "Models: " + m.modelsInput.View(),
        "",
        helpStyle.Render("Press Enter to create, Esc to cancel"),
    )
    
    return borderStyle.Render(form)
}

// Confirmation dialogs
func (m Model) renderConfirmDialog(message string) string {
    return lipgloss.Place(
        m.width, m.height,
        lipgloss.Center, lipgloss.Center,
        borderStyle.Render(
            lipgloss.JoinVertical(
                lipgloss.Center,
                warningColor.Render("⚠️  Confirmation"),
                "",
                message,
                "",
                helpStyle.Render("y/n"),
            ),
        ),
    )
}
```

### Performance Optimization
```go
// Debounced input handling
func debounce(delay time.Duration, fn func()) tea.Cmd {
    return tea.Tick(delay, func(time.Time) tea.Msg {
        fn()
        return nil
    })
}

// Efficient rendering for large datasets
func (m Model) renderLargeTable(items []interface{}) string {
    // Only render visible items
    start, end := m.calculateVisibleRange()
    visibleItems := items[start:end]
    
    // Create virtual scrolling effect
    return m.renderTableRows(visibleItems)
}
```

