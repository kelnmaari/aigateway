## 🔒 Security Standards

### Input Validation
```go
func validateChatRequest(req ChatCompletionRequest) error {
    if req.Model == "" {
        return ValidationError{Field: "model", Message: "required"}
    }
    
    if len(req.Messages) == 0 {
        return ValidationError{Field: "messages", Message: "at least one message required"}
    }
    
    // Validate message content length
    for i, msg := range req.Messages {
        if len(msg.Content) > MaxMessageLength {
            return ValidationError{
                Field:   fmt.Sprintf("messages[%d].content", i),
                Message: fmt.Sprintf("exceeds maximum length of %d characters", MaxMessageLength),
                Value:   len(msg.Content),
            }
        }
    }
    
    return nil
}
```

### API Key Handling
```go
// NEVER log actual API keys
func (m *APIKeyManager) CreateKey(ctx context.Context, name string, models []string) (*APIKey, error) {
    key := &APIKey{
        ID:       generateSecureID(),
        Name:     name,
        Models:   models,
        Created:  time.Now(),
        LastUsed: nil,
        // Generate secure random key
        KeyHash:  m.hashKey(generateSecureKey(32)),
    }
    
    // Log creation (without sensitive data)
    m.logger.WithFields(logrus.Fields{
        "event":   "api_key_created",
        "key_id":  key.ID,
        "name":    name,
        "models":  models,
    }).Info("API key created")
    
    return key, m.storage.SaveKey(key)
}

// Always hash keys for storage
func (m *APIKeyManager) hashKey(plainKey string) string {
    hash, err := bcrypt.GenerateFromPassword([]byte(plainKey), bcrypt.DefaultCost)
    if err != nil {
        panic(fmt.Sprintf("failed to hash API key: %v", err)) // This should never happen
    }
    return string(hash)
}
```

## 📊 Performance Standards

### Context Usage
```go
// Always propagate context for cancellation and timeouts
func (c *OllamaClient) ChatCompletion(ctx context.Context, req OllamaChatRequest) (*OllamaChatResponse, error) {
    // Set timeout for this specific operation
    ctx, cancel := context.WithTimeout(ctx, c.timeout)
    defer cancel()
    
    // Check if context was cancelled before making request
    select {
    case <-ctx.Done():
        return nil, ctx.Err()
    default:
    }
    
    return c.makeHTTPRequest(ctx, req)
}
```

### Connection Pooling
```go
// Reuse HTTP connections
func NewOllamaClient(url string) *OllamaClient {
    return &OllamaClient{
        url: url,
        client: &http.Client{
            Timeout: 30 * time.Second,
            Transport: &http.Transport{
                MaxIdleConns:       100,
                MaxIdleConnsPerHost: 10,
                IdleConnTimeout:    90 * time.Second,
            },
        },
    }
}
```

### Memory Management
```go
// Use sync.Pool for frequently allocated objects
var chatResponsePool = sync.Pool{
    New: func() interface{} {
        return &ChatCompletionResponse{
            Choices: make([]ChatCompletionChoice, 0, 1),
        }
    },
}

func getChatResponse() *ChatCompletionResponse {
    resp := chatResponsePool.Get().(*ChatCompletionResponse)
    // Reset the response
    resp.ID = ""
    resp.Choices = resp.Choices[:0]
    return resp
}

func putChatResponse(resp *ChatCompletionResponse) {
    chatResponsePool.Put(resp)
}
```

