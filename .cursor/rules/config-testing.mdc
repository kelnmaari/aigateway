# Configuration & Testing Guidelines

## 🔧 Configuration Management

### Configuration Structure

```go
type ServerConfig struct {
    Host         string        `mapstructure:"host" validate:"required"`
    Port         int           `mapstructure:"port" validate:"min=1,max=65535"`
    ReadTimeout  time.Duration `mapstructure:"read_timeout"`
    WriteTimeout time.Duration `mapstructure:"write_timeout"`
}

func (c *Config) Validate() error {
    validate := validator.New()
    return validate.Struct(c)
}
```

### Environment Variables

```go
func setupViper() *viper.Viper {
    v := viper.New()
    
    v.SetEnvPrefix("AIGATEWAY")
    v.AutomaticEnv()
    v.SetEnvKeyReplacer(strings.NewReplacer(".", "_"))
    
    v.SetConfigName("config")
    v.SetConfigType("yaml")
    v.AddConfigPath("./configs")
    
    return v
}
```

### Defaults

```go
func setDefaults(v *viper.Viper) {
    v.SetDefault("server.host", "0.0.0.0")
    v.SetDefault("server.port", 8080)
    v.SetDefault("server.read_timeout", "30s")
    
    v.SetDefault("database.driver", "postgresql")
    
    v.SetDefault("auth.enabled", true)
    v.SetDefault("auth.rate_limiting.enabled", true)
}
```

## 🧪 Testing Patterns

### Test Naming

```go
// TestFunctionName_Scenario_ExpectedBehavior
func TestConfigLoad_ValidFile_ReturnsConfig(t *testing.T) {}
func TestConfigLoad_InvalidFile_ReturnsError(t *testing.T) {}
```

### Table-Driven Tests

```go
func TestConfigValidation(t *testing.T) {
    tests := []struct {
        name      string
        config    Config
        wantError bool
    }{
        {
            name:      "valid config",
            config:    Config{Server: ServerConfig{Port: 8080}},
            wantError: false,
        },
        {
            name:      "invalid port",
            config:    Config{Server: ServerConfig{Port: 0}},
            wantError: true,
        },
    }
    
    for _, tt := range tests {
        t.Run(tt.name, func(t *testing.T) {
            err := tt.config.Validate()
            if tt.wantError {
                assert.Error(t, err)
            } else {
                assert.NoError(t, err)
            }
        })
    }
}
```

### Handler Testing

```go
func TestHandler(t *testing.T) {
    gin.SetMode(gin.TestMode)
    router := gin.New()
    
    mockService := &MockService{}
    handler := NewHandler(mockService)
    router.POST("/api/resource", handler.Create)
    
    t.Run("success", func(t *testing.T) {
        mockService.On("Create", mock.Anything).Return(&Resource{}, nil)
        
        w := httptest.NewRecorder()
        r := httptest.NewRequest("POST", "/api/resource", body)
        r.Header.Set("Content-Type", "application/json")
        
        router.ServeHTTP(w, r)
        
        assert.Equal(t, 200, w.Code)
    })
}
```

### Mock Pattern

```go
type MockService struct {
    mock.Mock
}

func (m *MockService) Create(ctx context.Context, req Request) (*Result, error) {
    args := m.Called(ctx, req)
    return args.Get(0).(*Result), args.Error(1)
}
```

### Benchmarks

```go
func BenchmarkHandler(b *testing.B) {
    // Setup
    router := setupTestRouter()
    reqBody, _ := json.Marshal(request)
    
    b.ResetTimer()
    for i := 0; i < b.N; i++ {
        w := httptest.NewRecorder()
        r := httptest.NewRequest("POST", "/api/endpoint", bytes.NewBuffer(reqBody))
        router.ServeHTTP(w, r)
    }
}
```

