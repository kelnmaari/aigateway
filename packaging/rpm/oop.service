[Unit]
Description=Ollama OpenAI Proxy Server (AIGateway)
Documentation=https://github.com/kelnmaari/ollama-openai-proxy
After=network.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ollama-openai-proxy
ExecStart=/opt/ollama-openai-proxy/bin/server -config /opt/ollama-openai-proxy/configs/dev.yaml

# Environment
Environment="GIN_MODE=release"
Environment="YZMA_LIB=/usr/local/llama/"

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=1800s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity

# Security hardening (optional, comment if causes issues)
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/opt/ollama-openai-proxy/data

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ollama-proxy

[Install]
WantedBy=multi-user.target

