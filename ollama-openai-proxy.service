[Unit]
Description=AIGateway Server
Documentation=https://github.com/kelnmaari/ollama-openai-proxy
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/aigateway
ExecStart=/opt/aigateway/bin/server -config /opt/aigateway/configs/config.yaml

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3
# Resource limits
LimitNOFILE=65536
MemoryLimit=2G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aigateway

# Environment
Environment="GIN_MODE=release"

[Install]
WantedBy=multi-user.target
