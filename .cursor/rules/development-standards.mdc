## 🔒 Security Standards

### Input Validation
```go
func validateChatRequest(req ChatCompletionRequest) error {
    if req.Model == "" {
        return ValidationError{Field: "model", Message: "required"}
    }
    
    if len(req.Messages) == 0 {
        return ValidationError{Field: "messages", Message: "at least one message required"}
    }
    
    for i, msg := range req.Messages {
        if len(msg.Content) > MaxMessageLength {
            return ValidationError{
                Field:   fmt.Sprintf("messages[%d].content", i),
                Message: fmt.Sprintf("exceeds maximum length of %d characters", MaxMessageLength),
                Value:   len(msg.Content),
            }
        }
    }
    
    return nil
}
```

### API Key Handling
```go
// NEVER log actual API keys
func (m *APIKeyManager) CreateKey(ctx context.Context, name string, models []string) (*APIKey, error) {
    key := &APIKey{
        ID:       generateSecureID(),
        Name:     name,
        Models:   models,
        Created:  time.Now(),
        KeyHash:  m.hashKey(generateSecureKey(32)),
    }
    
    m.logger.WithFields(logrus.Fields{
        "event":   "api_key_created",
        "key_id":  key.ID,
        "name":    name,
    }).Info("API key created")
    
    return key, m.storage.SaveKey(key)
}

// Always hash keys for storage
func (m *APIKeyManager) hashKey(plainKey string) string {
    hash, _ := bcrypt.GenerateFromPassword([]byte(plainKey), bcrypt.DefaultCost)
    return string(hash)
}
```

## 📊 Performance Standards

### Context Usage
```go
// Always propagate context for cancellation and timeouts
func (p *Provider) ChatCompletion(ctx context.Context, req ChatRequest) (*ChatResponse, error) {
    ctx, cancel := context.WithTimeout(ctx, p.timeout)
    defer cancel()
    
    select {
    case <-ctx.Done():
        return nil, ctx.Err()
    default:
    }
    
    return p.makeHTTPRequest(ctx, req)
}
```

### Connection Pooling
```go
func NewHTTPClient() *http.Client {
    return &http.Client{
        Timeout: 120 * time.Second,
        Transport: &http.Transport{
            MaxIdleConns:        100,
            MaxIdleConnsPerHost: 10,
            IdleConnTimeout:     90 * time.Second,
        },
    }
}
```

### Memory Management
```go
// Use sync.Pool for frequently allocated objects
var responsePool = sync.Pool{
    New: func() interface{} {
        return &ChatCompletionResponse{
            Choices: make([]ChatCompletionChoice, 0, 1),
        }
    },
}

func getResponse() *ChatCompletionResponse {
    resp := responsePool.Get().(*ChatCompletionResponse)
    resp.ID = ""
    resp.Choices = resp.Choices[:0]
    return resp
}

func putResponse(resp *ChatCompletionResponse) {
    responsePool.Put(resp)
}
```

